# vim: set ft=toml

[hooks]
pre-merge = "just"

# Per-commit repair: format the index-staged content at authoring time so every
# commit is conformant in history (rather than catching drift later at `just
# codemod-fmt` / merge). spinclass installs this as a per-worktree git
# pre-commit hook at `sc start`/`sc resume` (spinclass-sweatfile(5)); it is
# best-effort, non-blocking, and restages formatted blobs in place (lint-staged
# semantics — no extra commit, no amend).
#
# `conformist-pre-commit` is the blessed (conformist#47/#51), config-specific,
# store-pinned hook: cutting-garden's flake exposes it from its own
# `conformistEval.config.build.preCommit` (the nix-module migration,
# cutting-garden#114) and puts it on the devShell PATH. It wraps `conformist
# --staged --exit-zero-on-fix` with this repo's generated store config, so the
# staged repair formats *.go/*.nix/etc. with the SAME pinned toolchain as
# `nix fmt` — no reliance on the formatters being on the author's PATH (the
# silent-skip trap of a bare `conformist --staged`). `--exit-zero-on-fix` (baked
# into the wrapper) maps the restage's exit-3 to 0 so a successful repair lets
# the commit proceed. Requires the devShell active (direnv) so the hook is on
# PATH.
pre-commit = "conformist-pre-commit"
